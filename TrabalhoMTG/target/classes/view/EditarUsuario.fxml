<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="560.0" prefWidth="820.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EditarUsuarioController">

   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <padding>
            <Insets bottom="5.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#btnVoltarOnAction" text="Voltar" />
         </children>
      </HBox>
   </top>

   <left>
      <VBox prefWidth="300.0" spacing="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="10.0" top="20.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Dados do usuário" />

            <Label text="Nome" />
            <TextField fx:id="txtNome" promptText="Nome de usuário" />

            <Label text="Senha" />
            <PasswordField fx:id="psfSenha" promptText="Senha" />

            <HBox spacing="8.0">
               <padding>
                  <Insets top="12.0" />
               </padding>
               <children>
                  <Button mnemonicParsing="false" onAction="#btnNovoOnAction" text="Novo" />
                  <Button mnemonicParsing="false" onAction="#btnSalvarOnAction" text="Salvar" />
                  <Button mnemonicParsing="false" onAction="#btnAtualizarOnAction" text="Atualizar" />
                  <Button mnemonicParsing="false" onAction="#btnExcluirOnAction" text="Excluir" />
               </children>
            </HBox>

            <Label fx:id="lblMensagem" wrapText="true" />
         </children>
      </VBox>
   </left>

   <center>
      <VBox spacing="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Usuários cadastrados" />
            <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" maxWidth="80.0" minWidth="50.0" prefWidth="60.0" text="Id" />
                  <TableColumn fx:id="colNome" prefWidth="300.0" text="Nome" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
