<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="560.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CadastroCartaController">

    <center>
        <VBox spacing="12.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Dados da carta" />

                <Label text="Nome" />
                <TextField fx:id="txtNome" promptText="Ex.: Elfos de Llanowar" />

                <Label text="Tipo" />
                <ComboBox fx:id="cbTipo" maxWidth="1.7976931348623157E308" promptText="Escolha o tipo" />

                <Label text="Supertipo" />
                <ComboBox fx:id="cbSupertipo" maxWidth="1.7976931348623157E308" promptText="(opcional)" />

                <Label text="Subtipo" />
                <ComboBox fx:id="cbSubtipo" maxWidth="1.7976931348623157E308" promptText="(opcional)" />

                <HBox spacing="10.0">
                    <children>
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Vida" />
                                <TextField fx:id="txtVida" promptText="Ex.: 2" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Dano" />
                                <TextField fx:id="txtDano" promptText="Ex.: 3" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="8.0">
                    <padding>
                        <Insets top="12.0" />
                    </padding>
                    <children>
                        <Button mnemonicParsing="false" onAction="#btnNovoOnAction" text="Novo"/>
                        <Button mnemonicParsing="false" onAction="#btnExcluirOnAction" text="Excluir" />
                        <Button mnemonicParsing="false" onAction="#btnAtualizarOnAction" text="Atualizar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

</BorderPane>